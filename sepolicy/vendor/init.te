allow init {
    boot_block_device
    dtbo_block_device
    vbmeta_block_device
    vendor_block_device
}:lnk_file relabelto;

allow init {
    efs_file
    persist_file
    mnt_product_file
    mnt_vendor_file
}:dir mounton;

allow init proc_last_kmsg:file create_file_perms;
allow init proc_printk:file w_file_perms;

allow init sysfs_scheduler:file create_file_perms;

allow init vendor_sysfs_mmc_host:file w_file_perms;

r_dir_file(init, functionfs)
allow init functionfs:dir mounton;
