# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# Dynamic Partitions
odm                                             /odm                  ext4    ro,barrier=1,discard                                                                         wait,slotselect,logical,first_stage_mount
product                                         /product              ext4    ro,barrier=1,discard                                                                         wait,slotselect,logical,first_stage_mount
system                                          /system               ext4    ro,barrier=1,discard                                                                         wait,slotselect,logical,first_stage_mount
system_ext                                      /system_ext           ext4    ro,barrier=1,discard                                                                         wait,slotselect,logical,first_stage_mount
vendor                                          /vendor               ext4    ro,barrier=1,discard                                                                         wait,slotselect,logical,first_stage_mount

# Partitions
/dev/block/by-name/metadata                     /metadata             ext4    noatime,nosuid,nodev,discard,data=ordered,barrier=1                                          wait,formattable,first_stage_mount,check
/dev/block/bootdevice/by-name/efs               /mnt/vendor/efs       ext4    noatime,nosuid,nodev,barrier=1,rw                                                            wait
/dev/block/bootdevice/by-name/misc              /misc                 emmc    defaults                                                                                     defaults
/dev/block/bootdevice/by-name/persist           /mnt/vendor/persist   ext4    noatime,nosuid,nodev,barrier=1,data=ordered,nodelalloc,nomblk_io_submit,errors=panic         wait,notrim
/dev/block/bootdevice/by-name/persist2          /mnt/product/persist  ext4    noatime,nosuid,nodev,barrier=1                                                               wait,formattable,nofail
/dev/block/bootdevice/by-name/slotinfo          /slotinfo             emmc    defaults                                                                                     defaults
/dev/block/bootdevice/by-name/userdata          /data                 f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt latemount,wait,check,quota,formattable,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,fscompress,readahead_size_kb=128

# VOLD
/devices/platform/13550000.dwmmc2/mmc_host*     auto                  auto    default                                                                                      voldmanaged=sdcard1:auto,encryptable=userdata

/devices/platform/13200000.usb*	                auto                  vfat    default                                                                                      voldmanaged=usb1:auto
/devices/platform/13200000.usb/13200000.dwc3*   auto                  vfat    default                                                                                      voldmanaged=usb2:auto

# ZRAM
/dev/block/zram0                                none                  swap    defaults                                                                                     zramsize=2147483648,max_comp_streams=8
