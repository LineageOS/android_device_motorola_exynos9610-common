cc_library_shared {
    name: "gatekeeper.exynos9610",
    relative_install_path: "hw",
    proprietary: true,

    srcs: [
      "src/*.cpp",
      "src/*.c"
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wmissing-field-initializers",
        "-Wunused-parameter",
        "-DUSE_VENDOR_PARTITION"
    ],
    cppflags: ["-std=c++11"] + [
        "-fpermissive",
        "-Wall",
        "-Werror",
        "-D__STDC_LIMIT_MACROS",
        "-D__FAILURE_RECORD_STORAGE_IN_SECURE_OBJECT__"
    ],

    local_include_dirs: ["include"],

    include_dirs: [
      "hardware/libhardware/include/",
      "system/core/libsystem/include/",
      "system/core/libcutils/include_outside_system/"
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libdl",
        "libgatekeeper",
        "//hardware/samsung_slsi-linaro/exynos/tee/kinibi410:libMcClient"
    ],
}
