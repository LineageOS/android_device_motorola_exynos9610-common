cc_binary {
    name: "android.hardware.vibrator-service.exynos9610",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.exynos9610.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.exynos9610.xml"],
    srcs: ["service.cpp", "Vibrator.cpp"],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libbinder_ndk",
    ],
    static_libs: [
        "android.hardware.vibrator-V1-ndk",
    ],
}
