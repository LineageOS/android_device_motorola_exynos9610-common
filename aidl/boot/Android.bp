cc_defaults {
    name: "android.hardware.boot-service_common-exynos9610",
    relative_install_path: "hw",
    defaults: ["libboot_control_defaults"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhardware",
        "libutils",
        "android.hardware.boot@1.1",
        "android.hardware.boot-V1-ndk",
    ],
    static_libs: [
        "libboot_control",
        "libbootloader_message_vendor",
    ],
    srcs: [
        "BootControl.cpp",
        "GptUtils.cpp",
        "service.cpp"
    ],
}

cc_binary {
    name: "android.hardware.boot-service.default-exynos9610",
    defaults: ["android.hardware.boot-service_common-exynos9610"],
    init_rc: ["android.hardware.boot-service.default-exynos9610.rc"],
    vendor: true,
}

cc_binary {
    name: "android.hardware.boot-service.default_recovery-exynos9610",
    defaults: ["android.hardware.boot-service_common-exynos9610"],
    vintf_fragments: ["android.hardware.boot-service.default_recovery-exynos9610.xml"],
    init_rc: ["android.hardware.boot-service.default_recovery-exynos9610.rc"],
    recovery: true,
}
